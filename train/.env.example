# Where the NAS exposes built dataset packages. Either a local mount
# (NFS/SMB) or an ssh remote for rsync:
#   NAS_DATASETS=/mnt/nas/finetune/datasets
#   NAS_DATASETS=user@nas.local:/volume1/finetune/datasets
NAS_DATASETS=

# ComfyUI model dirs on this GPU box:
CKPT_DIR=/path/to/ComfyUI/models/checkpoints
LORA_DIR=/path/to/ComfyUI/models/loras
