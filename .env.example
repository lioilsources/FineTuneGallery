# Where images/DB/datasets live on the NAS (mounted at /data in the container).
DATA_DIR=/volume1/finetune

# Only needed if the cloudflared service in docker-compose.yml is enabled:
# TUNNEL_TOKEN=

# AiStack LLM gateway on the LAN (gateway :8080 → LiteLLM). Empty = prompt
# translation and the VL judge are off; the app sends prose (fail open).
#   prompt-tags  prose → Danbooru tags for the booru checkpoints; a SPARK
#                broker add-on to the comfy profile (AiStack: prompt-tags)
#   judge        relational-criteria rater, calibrated per criterion (κ gate);
#                qwen36 in the llm profile — calibrate in that window
# Check after `docker compose up -d`:  curl localhost:8092/api/meta | jq .translator
# vocab > 0 means the tagger vocabulary arrived from SPARK; 0 means 503 until it does.
# LLM_GATEWAY_URL=http://<spark>:8080
# TRANSLATE_MODEL=prompt-tags
# JUDGE_MODEL=judge
