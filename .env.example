# Content taxonomy (UC25): 1 = facets, temperature, label queue, import.
# The minor block runs without it. Turning it on is a deploy decision.
# FINETUNE_TAXONOMY=1
# The GPU batch's own token (Authorization: Bearer): opens only
# POST /api/taxonomy/import and PUT /api/taxonomy/thresholds. The batch
# reaches the gallery through CF Access with its own service token
# (CF_ACCESS_CLIENT_ID/SECRET + FINETUNE_URL + FINETUNE_WORKER_TOKEN in the
# batch's .env on the GPU box — see taxo/push.py), never a LAN port.
# WORKER_TOKEN=

# Where images/DB/datasets live on the NAS (mounted at /data in the container).
DATA_DIR=/volume1/finetune

# Only needed if the cloudflared service in docker-compose.yml is enabled:
# TUNNEL_TOKEN=
